# Backend settings — copy to backend/.env and edit.
# Every key is read with the GYM_ prefix (see app/core/config.py).
# backend/.env is gitignored on purpose: it holds secrets. This example
# file documents every variable the backend understands.

# ── Database ─────────────────────────────────────────────────────────────
# Local dev (make db-init creates this role + database):
GYM_DATABASE_URL=postgresql+asyncpg://gym:gym_dev_pass@127.0.0.1:5432/gym_erp
# Supabase: Project Settings → Database → Connection string (URI). Append
# ?ssl=require so the driver negotiates TLS (handled in app/db/session.py).
# GYM_DATABASE_URL=postgresql+asyncpg://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?ssl=require

# ── Environment ──────────────────────────────────────────────────────────
# development | test | production
GYM_ENVIRONMENT=development
GYM_DEBUG=false
GYM_APP_NAME="Gym ERP"
GYM_API_PREFIX=/api/v1

# ── Auth / JWT ───────────────────────────────────────────────────────────
# Leave the key fields empty to fall back to HS256 + GYM_JWT_HMAC_SECRET
# (a hardcoded dev secret is used when that is empty too — never do that in
# production). Set both key fields to switch to ES256.
GYM_JWT_ALGORITHM=ES256
GYM_JWT_PRIVATE_KEY=
GYM_JWT_PUBLIC_KEY=
GYM_JWT_HMAC_SECRET=
GYM_ACCESS_TOKEN_TTL_SECONDS=900
GYM_REFRESH_TOKEN_TTL_SECONDS=2592000
GYM_ISSUER=gym-erp

# ── CORS ─────────────────────────────────────────────────────────────────
GYM_ALLOWED_ORIGINS=["http://localhost:3000"]
GYM_CORS_ALLOW_CREDENTIALS=true

# ── Background jobs (transactional outbox + renewals) ────────────────────
GYM_OUTBOX_POLL_INTERVAL_SECONDS=1.0
GYM_OUTBOX_MAX_DELIVERIES=5
GYM_RENEWAL_INTERVAL_SECONDS=30.0

# ── Misc ─────────────────────────────────────────────────────────────────
# Platform (super-admin) tenant id — leave as-is.
GYM_PLATFORM_TENANT_ID=00000000-0000-0000-0000-000000000000
# Platform admin credentials used by `make seed` / `make reset`. Both are
# REQUIRED; seed fails fast if either is empty. Password must satisfy the
# complexity rules (uppercase, lowercase, digit, special, length >= 8).
# These are placeholders — set real values in backend/.env, never commit it.
GYM_PLATFORM_ADMIN_EMAIL=
GYM_PLATFORM_ADMIN_PASSWORD=
# Uploaded media (member avatars), relative to backend/.
GYM_MEDIA_DIR=media
# Optional Redis (reserved for future use; unused today).
GYM_REDIS_URL=
