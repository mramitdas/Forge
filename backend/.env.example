# Backend settings. Every value here is optional — the app runs on the
# defaults baked into app/core/config.py, which are already correct for local
# development (see `make db-init`). Copy to backend/.env to override.
#
# All keys are read with the GYM_ prefix.

# SQLAlchemy async URL. `make db-init` creates this role + database.
GYM_DATABASE_URL=postgresql+asyncpg://gym:gym_dev_pass@127.0.0.1:5432/gym_erp

# development | test | production
GYM_ENVIRONMENT=development
GYM_DEBUG=false

# JWT signing. Leave both keys empty to fall back to HS256, which uses
# GYM_JWT_HMAC_SECRET (or a hardcoded dev secret when that is empty too).
# Set both to switch to ES256.
GYM_JWT_ALGORITHM=ES256
GYM_JWT_PRIVATE_KEY=
GYM_JWT_PUBLIC_KEY=
GYM_JWT_HMAC_SECRET=

# Browser origins allowed to call the API.
GYM_ALLOWED_ORIGINS=["http://localhost:3000"]

# Where uploaded media (member avatars, etc.) is stored, relative to backend/.
GYM_MEDIA_DIR=media
