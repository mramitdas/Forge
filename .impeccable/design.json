      "css": ".ds-card{padding:20px;border-radius:16px;background:var(--color-panel,rgba(28,29,38,0.72));border:1px solid var(--color-line,rgba(255,255,255,0.09));border-top-color:rgba(255,255,255,0.35);box-shadow:0 8px 24px var(--color-shadow,rgba(0,0,0,0.4));backdrop-filter:blur(20px) saturate(1.4);color:var(--color-ink,#f0f1f7);font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",Roboto,sans-serif}\n.ds-card__row{display:flex;align-items:center;justify-content:space-between}\n.ds-kicker{font-size:10.5px;font-weight:700;letter-spacing:0.18em;color:var(--color-ink-faint,#8a8ca0)}\n.ds-card__amount{margin:10px 0 2px;font-size:26px;font-weight:600;letter-spacing:-0.02em;font-variant-numeric:tabular-nums}\n.ds-card__meta{margin:0;font-size:12px;color:var(--color-ink-soft,#b8bacb)}\n.ds-badge{display:inline-flex;align-items:center;gap:6px;padding:2px 8px;border-radius:999px;background:var(--color-green-soft,rgba(79,215,160,0.16));color:var(--color-green,#4fd7a0);font-size:11px;font-weight:600;line-height:1.6}"
