  "narrative": {
    "northStar": "The Instrument Panel",
    "overview": "Forge should feel like a well-calibrated cockpit for a gym, not a website about one. The workspace is dark by default — Midnight Graphite, periwinkle signals, cool grey type — with a light porcelain mode for daylight. Surfaces are translucent glass over a quiet ambient field of pastel glows, so the chrome recedes and the numbers lead. Density is deliberate: tables, metric tiles, and forms are compact but never crowded, and the eye can always find the primary action.\n\nCalm, exact, quietly premium. Precision shows up in alignment, consistently formatted money, a 4-point spacing scale, and a single accent reserved for action and state. Nothing is decorated to look busy: no ornamental gradients on content, no glow behind text, no card inside a card.\n\nThe system explicitly rejects legacy gym software such as Mindbody: grey form walls, density without hierarchy, and modal-on-modal workflows. Familiarity is the goal — an operator fluent in Linear or a native macOS tool should trust every screen immediately.",
    "keyCharacteristics": [
      "Dark-first Midnight Graphite canvas with periwinkle signals and a porcelain light mode.",
      "Layered glass panels with hairline borders and a 1px top edge highlight.",
      "Space Grotesk only for the wordmark and short headings; system sans for all operational text.",
      "One accent: primary action, active navigation, selected state. Never decoration.",
      "Compact 13px operating type, 4-point spacing, and 8/16px radii."
    ],
    "rules": [
      {
        "name": "The One Signal Rule",
        "body": "Periwinkle covers ≤10% of any screen: the primary action, the active nav item, selection, and focus. If two elements compete for it, one is wrong.",
        "section": "colors"
      },
      {
        "name": "The Ambient-Outside Rule",
        "body": "Pastel glows live behind the canvas and in the primary-action shadow. Never place a glow inside a card, behind text, or on a resting surface.",
        "section": "colors"
      },
      {
        "name": "The Wordmark-Only Rule",
        "body": "Space Grotesk is for the wordmark and short headings. Table data, labels, buttons, and body copy always use the system sans.",
        "section": "typography"
      },
      {
        "name": "The Fixed-Scale Rule",
        "body": "Product type is fixed px. No clamp() in the app shell; a heading that shrinks in a sidebar is worse, not better.",
        "section": "typography"
      },
      {
        "name": "The Glass-at-Rest Rule",
        "body": "Panels are glass at rest. Shadows appear to mark elevation (modal, toast) or action (primary button), never to decorate a flat surface.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do put the primary action in a top action row where the eye lands first; routine tasks never hide behind menus.",
      "Do scope every money and count figure visibly to its period (for example the year selector beside the expense total).",
      "Do use the 4-point spacing scale (4/8/12/16/20/24) and the radius scale (6/8/10/16/999).",
      "Do keep Periwinkle Signal at ≤10% of the screen and reserve it for action, active state, and focus.",
      "Do give every interactive element a visible keyboard focus state; no invisible-focus controls.",
      "Do keep glass panels at rest and use shadow only for elevation or action."
    ],
    "donts": [
      "Don't reproduce legacy gym software (Mindbody): cluttered, dated, enterprise-heavy screens, with density without hierarchy, grey form walls, or modal-on-modal workflows for routine tasks.",
      "Don't use gradient text beyond the existing greeting exception; no new background-clip text effects.",
      "Don't use Space Grotesk in table data, labels, or long copy.",
      "Don't use clamp() for product type or fluid rem scales in the app shell.",
      "Don't nest cards, wrap every group in a card, or use a card where spacing and a divider suffice.",
      "Don't place glows or heavy shadows inside content, behind text, or on resting surfaces.",
      "Don't use border-left/right stripes, glassmorphism for its own sake, or decorative motion that does not convey state.",
      "Don't ship a control without hover, focus, active, disabled, and loading states."
    ]
  }
}
