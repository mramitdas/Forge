# Frontend env — copy to apps/web/.env.local (gitignored).
# The Next.js app proxies /api and /health to the backend, so in local dev
# no variables are required. Set API_BACKEND_URL when the backend is
# somewhere other than http://localhost:8000 (e.g. a deployed API, or the
# FastAPI app running against Supabase Postgres).

API_BACKEND_URL=http://localhost:8000
